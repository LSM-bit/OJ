# ============ OJ 部署环境变量模板（勿直接使用，复制为 api.env 填真实值） ============
# 本文件由三个服务共用（compose 的 service 级 env_file 把内容翻译成容器环境变量）：
#   postgres 只读 POSTGRES_*；minio 只读 MINIO_ROOT_*；api 读 DATABASE_URL 等其余全部
# 密钥生成：openssl rand -hex 32       令牌生成：openssl rand -hex 24
# 复制后：chmod 600 api.env（密钥文件，已被 gitignore，绝不入库）

# ---- Postgres（postgres 服务首启初始化凭据）----
POSTGRES_USER=oj
POSTGRES_PASSWORD=<openssl rand -hex 24>
POSTGRES_DB=oj

# ---- api 服务（容器内域名：postgres / redis / minio 均为 compose 服务名）----
# DATABASE_URL 中的密码必须与上面 POSTGRES_PASSWORD 一致（否则连不上）
DATABASE_URL=postgresql+asyncpg://oj:<同 POSTGRES_PASSWORD>@postgres:5432/oj
REDIS_URL=redis://redis:6379/0
DEBUG=false
JWT_SECRET=<openssl rand -hex 32>

# ---- MinIO ----
# MINIO_ROOT_PASSWORD 必须与下面 MINIO_SECRET_KEY 一致（首启初始化后改动不生效，需删卷重建）
MINIO_ROOT_USER=oju
MINIO_ROOT_PASSWORD=<openssl rand -hex 24>
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=oju
MINIO_SECRET_KEY=<同 MINIO_ROOT_PASSWORD>

# ---- 节点令牌（JSON 数组语法，引号/方括号原样保留）----
# JUDGE_GATEWAY_TOKENS[0] 必须与 deploy/judge-node.env 的 SERVER_TOKEN 一致
JUDGE_GATEWAY_TOKENS=["<openssl rand -hex 24>"]
# ASSISTANT_NODE_TOKENS[0] 必须与 deploy/.env 的 SERVER_TOKEN 一致
ASSISTANT_NODE_TOKENS=["<openssl rand -hex 24>"]

# ---- AI 助手模型（与 dev 保持一致；节点侧另配 ANTHROPIC_API_KEY）----
ASSISTANT_MODEL=deepseek-chat

# ---- 初始管理员（api 容器首启自动创建；仅首次生效，已存在则跳过）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<强密码，登录后尽快更换>
