*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
dist/
*.local

# 环境与密钥
.env
.env.*
!.env.example

# deploy 下的密钥文件（api.env 等命名不匹配上面的 .env.* 精确模式，必须单独写）
